# Copy this file to ".env" and fill in real values before deploying.
# The server works without any of this filled in — orders and logins
# still function — but no receipt emails will actually send until
# SMTP is configured below.

# Random long string used to sign session cookies. Change this to
# a random value of at least 32 characters before going live.
SESSION_SECRET=change-this-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=replace-with-a-random-password-of-at-least-16-characters

# Port the server runs on
PORT=3000

# Comma-separated exact production frontend origins; localhost origins are
# allowed for local development. Example: https://shop.example.com
APP_ORIGINS=
# ---- Email (SMTP) — required for automatic receipt emails ----
# Example using Gmail: create an "App Password" in your Google Account
# security settings (regular Gmail passwords won't work here).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
FROM_EMAIL=your-email@gmail.com

# Optional SQLite backup archive in Firebase Storage
# Set the bucket name shown in Firebase Console > Storage, without "gs://".
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
