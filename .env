# Copy this file to ".env" and fill in real values before deploying.
# The server works without any of this filled in — orders and logins
# still function — but no receipt emails will actually send until
# SMTP is configured below.

# Random long string used to sign session cookies. Change this to
# anything random before going live.
SESSION_SECRET=change-this-to-a-long-random-string

# Port the server runs on
PORT=3000

# Firebase Web App configuration (public identifiers)
APP_ORIGINS=http://localhost:3000
# Store the Firebase Admin service-account JSON outside this repository.

# ---- Email (SMTP) — required for automatic receipt emails ----
# Example using Gmail: create an "App Password" in your Google Account
# security settings (regular Gmail passwords won't work here).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=# Copy this file to ".env" and fill in real values before deploying.
# The server works without any of this filled in — orders and logins
# still function — but no receipt emails will actually send until
# SMTP is configured below.

# Random long string used to sign session cookies. Change this to
# anything random before going live.
SESSION_SECRET=change-this-to-a-long-random-string

# Port the server runs on
PORT=3000

